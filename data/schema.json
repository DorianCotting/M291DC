{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/DorianCotting/M291DC/data/schema.json",
  "title": "Base de films CineMood",
  "description": "Valide data.json : un tableau de fiches de films.",
  "type": "array",
  "minItems": 30,
  "items": { "$ref": "#/definitions/film" },
  "definitions": {
    "film": {
      "type": "object",
      "required": ["id", "titre", "annee", "dureeMinutes", "genres", "humeurs", "contextes", "resume", "estFrancophone"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "titre": { "type": "string", "minLength": 1 },
        "annee": { "type": "integer", "minimum": 1895, "maximum": 2030 },
        "realisation": { "type": "string", "minLength": 1 },
        "dureeMinutes": { "type": "integer", "minimum": 1, "maximum": 300 },
        "genres": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "humeurs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["bonne-humeur", "fatigue", "triste", "frissons", "romantique", "reflechir", "rire"] }
        },
        "contextes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["seul", "couple", "amis", "famille"] }
        },
        "resume": { "type": "string", "minLength": 10, "maxLength": 300 },
        "estFrancophone": { "type": "boolean" },
        "image": { "type": "string", "pattern": "^images/[a-z0-9-]+\\.jpg$" }
      }
    }
  }
}
